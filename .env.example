PORT=8080

# Session cookie: Secure defaults to true (HTTPS-only). Set false only when the API is served over plain HTTP (e.g. local dev).
SESSION_COOKIE_SECURE=false
# strict | lax | none — use none only for a SPA on another origin; requires HTTPS in the browser when using none.
SESSION_COOKIE_SAMESITE=strict
# Comma-separated CIDRs for reverse proxies that may set X-Forwarded-For / X-Real-IP. Leave empty to trust no proxy (ClientIP = direct remote).
TRUSTED_PROXIES=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nervum
DB_SSLMODE=disable

FRONTEND_URL=http://localhost:5173
# Browser origins for CORS (comma-separated). Include the same URL as FRONTEND_URL unless you serve the SPA from multiple hosts. When unset, the API defaults to http://localhost:5173 and https://app.nervum.site.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.nervum.site
API_BASE_URL=http://localhost:8080
INTEGRATION_ENCRYPTION_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=