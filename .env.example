PORT=8080
# Comma-separated browser origins allowed to call the API with credentials (must include your SPA origin).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-ui.run.app
# When the SPA is on another origin than the API, session cookies need SameSite=None (with Secure).
# SESSION_COOKIE_SAMESITE=none
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nervum
DB_SSLMODE=disable
